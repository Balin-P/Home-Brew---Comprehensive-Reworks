local __util = require 'larian.util'

function FocusedWeaveCheck()
    return SpellId('Projectile_ElementalFletching_Acid_Focused') | SpellId('Projectile_ElementalFletching_Cold_Focused') | SpellId('Projectile_ElementalFletching_Fire_Focused')
    | SpellId('Projectile_ElementalFletching_Lightning_Focused') | SpellId('Projectile_ElementalFletching_Necrotic_Focused') | SpellId('Projectile_ElementalFletching_Poison_Focused')
    | SpellId('Projectile_ElementalFletching_Psychic_Focused') | SpellId('Projectile_ElementalFletching_Radiant_Focused') | SpellId('Projectile_ElementalFletching_Thunder_Focused')
    | SpellId('Shout_ElementalFletching')
end

function FrontierMastery()
    return SpellId('Target_BefuddlingStrike_Frontier') | SpellId('Target_BlindingStrike_Frontier') | SpellId('Target_CrowningStrike_Frontier')
    | SpellId('Shout_GrandSlam_Frontier') | SpellId('Target_LobotomizingStrike_Frontier') | SpellId('Target_SilencingStrike_Frontier')
    | SpellId('Target_TerrifyingStrike_Frontier') | SpellId('Shout_Vortex_Frontier') | SpellId('Projectile_BlindingShot_Frontier')
    | SpellId('Target_PostureBreaker_Frontier')    | SpellId('Zone_Cleave_Frontier') | SpellId('Target_ConcussiveSmash_Frontier')
    | SpellId('Target_CripplingStrike_Frontier') | SpellId('Target_DisarmingStrike_Frontier') | SpellId('Target_HeartStopper_Frontier')
    | SpellId('Target_Slash_New_Frontier')    | SpellId('Target_PiercingThrust_Frontier') | SpellId('Rush_SpringAttack_Frontier')
    | SpellId('Target_HinderingSmash_Frontier')    | SpellId('Projectile_HamstringShot_Frontier') | SpellId('Projectile_PiercingShot_Frontier')
end

function IsFocusedFletching()
    return SpellId('Projectile_ElementalFletching_Acid_Focused') | SpellId('Projectile_ElementalFletching_Cold_Focused') | SpellId('Projectile_ElementalFletching_Fire_Focused')
    | SpellId('Projectile_ElementalFletching_Lightning_Focused') | SpellId('Projectile_ElementalFletching_Necrotic_Focused') | SpellId('Projectile_ElementalFletching_Poison_Focused')
    | SpellId('Zone_ElementalFletching_Psychic_Focused') | SpellId('Projectile_ElementalFletching_Radiant_Focused') | SpellId('Projectile_ElementalFletching_Thunder_Focused')
end

function IsManeuver()
    return SpellId('Target_BaitAndSwitch') | SpellId('Interrupt_Brace') | SpellId('Shout_ChargeManeuver')
    | SpellId('Target_CommandersStrike') | SpellId('Target_DisarmingAttack') | SpellId('Projectile_DisarmingAttack')
    | SpellId('Target_DistractingStrike') | SpellId('Projectile_DistractingStrike') | SpellId('Shout_EvasiveFootwork')
    | SpellId('Target_FeintingAttack')    | SpellId('Target_ChallengersStrike') | SpellId('Projectile_ChallengersStrike')
    | SpellId('Shout_LungingAttack') | SpellId('Target_ManeuveringAttack') | SpellId('Projectile_ManeuveringAttack')
    | SpellId('Target_MenacingAttack')    | SpellId('Projectile_MenacingAttack') | SpellId('Shout_Parry')
    | SpellId('Shout_PrecisionAttack')    | SpellId('Target_PushingAttack') | SpellId('Projectile_PushingAttack')
    | SpellId('Throw_QuickToss') | SpellId('Target_Rally') | SpellId('Interrupt_Riposte')
    | SpellId('Zone_SweepingAttack') | SpellId('Target_TripAttack') | SpellId('Projectile_TripAttack')
    | SpellId('Projectile_Challengers_Call_Improved')
end

function IsDraconicSentinelAction()
    return SpellId('Target_SkyboundDive') | SpellId('Rush_DraconicBlitz') | SpellId('Target_DraconicMaul')
end
