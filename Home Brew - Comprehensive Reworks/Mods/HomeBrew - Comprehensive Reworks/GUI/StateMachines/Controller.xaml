<ls:StateMachine xmlns:ls="clr-namespace:ls;assembly=Code"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ls:StateMachine.States>
        <ls:State Name="PlayerNotifications" ModType="Extend">
            <ls:State.Widgets>
                <ls:StateWidget Filename="PR_NotificationToast.xaml" Layer="Notifications" IgnoreHitTest="True"/>
            </ls:State.Widgets>
        </ls:State>

        <ls:State Name="CharacterRespec" ModType="Extend">
            <ls:State.Widgets>
                <ls:StateWidget Filename="PR_RespecChoice_c.xaml" Layer="MessageBox"/>
            </ls:State.Widgets>
        </ls:State>
    </ls:StateMachine.States>
</ls:StateMachine>
